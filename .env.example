# 둘 다 비워두면 자동으로 브라우저 localStorage에 저장됩니다.
# Vercel KV(또는 Upstash Redis)를 연결하려면 아래 두 값을 채우세요.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# (선택) Google PageSpeed Insights API 키.
# 없어도 무료 호출이 가능하지만, 키를 넣으면 호출 한도가 늘어납니다.
# 키 발급: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
